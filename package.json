
{
  "name": "webcraft-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "node server.mjs",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.webcraftai.app",
    "productName": "WebCraft AI",
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ]
  }
}
